# 问星 H5 · AI 解读代理 —— 配置模板
#
# 用法：把本文件复制为同目录下的 .env，按需填写。
#   .env   已被 .gitignore 忽略，绝不会进入公开仓库
#   本模板不含任何密钥，随仓库发布，方便他人自建
#
# 托管平台不给环境变量入口时，配置就写在这里（server.js 启动时自动读取）。

# ---------- 大模型 ----------
# API Key。留空 = 走离线规则兜底文案（页面不报错，只是内容来自模板而非模型）
AI_KEY=

# 模型名与 OpenAI 兼容端点（默认 DeepSeek，可换通义 / 智谱 等）
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1/chat/completions

# ---------- 服务 ----------
# 监听端口。托管平台会用平台注入的 PORT 覆盖此值；本地默认 8787
PORT=8787

# 解读结果缓存秒数（默认 21600 = 6 小时）
AI_CACHE_TTL=21600

# 是否同时托管上级 tarot-h5 静态资源（1=是，前端与接口同源；0=只提供接口）
AI_SERVE_STATIC=1
